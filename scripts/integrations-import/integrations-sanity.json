    {
      "_id": "integration-asana",
      "_type": "integrationPage",
      "title": "Asana Integration with Superflow",
      "slug": {
        "_type": "slug",
        "current": "asana"
      },
      "metaTitle": "Asana Integration with Superflow",
      "metaDescription": "Turn your Superflow comments into Asana tasks or subtasks.",
      "authorName": "Vivek Khakhkhar",
      "publishedDateText": "2023-10-01",
      "publishedAtIso": "2023-10-01T00:00:00.000Z",
      "appName": "Asana",
      "isTaskApp": true,
      "linkToApp": "https://app.usesuperflow.com/dashboard/integrations",
      "installationVideoLink": "https://www.youtube.com/watch?v=d9NBSX9y6zE&list=PL1MR1SokI-MCZzTl7XvTwXiKVw_EDzkHq&index=4",
      "description": [
        {
          "_type": "block",
          "_key": "c1a3c6490464",
          "style": "normal",
          "markDefs": [
            {
              "_type": "link",
              "_key": "111cfd1b5f5b",
              "href": "https://asana.com/"
            }
          ],
          "children": [
            {
              "_type": "span",
              "_key": "e91999918550",
              "text": "Turn your Superflow comments into ",
              "marks": []
            },
            {
              "_type": "span",
              "_key": "3d2663c72d0f",
              "text": "Asana",
              "marks": [
                "111cfd1b5f5b"
              ]
            },
            {
              "_type": "span",
              "_key": "99220ae803e1",
              "text": " tasks or subtasks.",
              "marks": []
            }
          ]
        }
      ],
      "overview": [
        {
          "_type": "block",
          "_key": "787c40af10f0",
          "style": "normal",
          "markDefs": [],
          "children": [
            {
              "_type": "span",
              "_key": "7b9dbe579fa1",
              "text": "The integration of Asana with Superflow streamlines the process of converting Superflow comments into Asana tasks or subtasks. ",
              "marks": []
            },
            {
              "_type": "span",
              "_key": "2b9561fc225f",
              "text": "\n",
              "marks": []
            },
            {
              "_type": "span",
              "_key": "d4597500b67f",
              "text": "\n",
              "marks": []
            },
            {
              "_type": "span",
              "_key": "8769b3d517d3",
              "text": "This seamless integration ensures that Superflow aligns perfectly with your pre-existing workflow, allowing you to centralize website feedback and tasks within your current Asana projects.",
              "marks": []
            }
          ]
        }
      ],
      "steps": [
        {
          "_type": "integrationStep",
          "_key": "9d84ae68eaa8",
          "title": "Link to an Asana Workspace",
          "body": [
            {
              "_type": "block",
              "_key": "636f80824fae",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "c72de3cbef3f",
                  "text": "Navigate to the integrations page within the Superflow portal.",
                  "marks": []
                }
              ],
              "listItem": "bullet",
              "level": 1
            },
            {
              "_type": "block",
              "_key": "37f9d5ffcc98",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "83fb09be2f02",
                  "text": "Choose the desired Asana Workspace. This will serve as the destination for exported Superflow comments.",
                  "marks": []
                }
              ],
              "listItem": "bullet",
              "level": 1
            }
          ]
        },
        {
          "_type": "integrationStep",
          "_key": "d600d7379480",
          "title": "Associate a SuperFlow Project with an Asana Project:",
          "body": [
            {
              "_type": "block",
              "_key": "629a0eadd58d",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "cb4c5c386e3f",
                  "text": "Subsequently, establish a connection between a specific Superflow project and an Asana project.",
                  "marks": []
                }
              ],
              "listItem": "bullet",
              "level": 1
            },
            {
              "_type": "block",
              "_key": "2ade63ff796b",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "3e1de09cbe78",
                  "text": "All comments from Superflow will be automatically transformed into tasks within the designated Asana project.",
                  "marks": []
                }
              ],
              "listItem": "bullet",
              "level": 1
            }
          ]
        },
        {
          "_type": "integrationStep",
          "_key": "7d528984813b",
          "title": "Connect to a Specific Asana Task (Optional):",
          "body": [
            {
              "_type": "block",
              "_key": "298994cb34c4",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "f84bcc37cc93",
                  "text": "For more granular control, you have the option to link your Superflow project to a particular task within an Asana project.",
                  "marks": []
                }
              ],
              "listItem": "bullet",
              "level": 1
            },
            {
              "_type": "block",
              "_key": "c87fd45d3eca",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "1bdcbe8223fe",
                  "text": "In this configuration, all Superflow comments will materialize as subtasks beneath the chosen Asana task.",
                  "marks": []
                }
              ],
              "listItem": "bullet",
              "level": 1
            }
          ]
        }
      ],
      "framerThumbnailUrl": "https://framerusercontent.com/images/PhGFpuU9fA7UfZ2vHtoxObEMs.png",
      "framerThumbnailAlt": "Asana integration",
      "framerAppLogoUrl": "https://framerusercontent.com/images/RRHqEoMA3S582gEQaOqI20bwdS4.png",
      "framerAppLogoAlt": "Asana Logo",
      "framerInstallationVideoUrl": "https://framerusercontent.com/assets/DHvjAGo68RJFWnOnPIUBLtWdgnc.mp4"
    }
  ]
